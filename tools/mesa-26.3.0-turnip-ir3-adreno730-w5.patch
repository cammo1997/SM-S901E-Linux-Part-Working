+static bool
+tu_lookup_fence_hint(struct tu_device *dev, struct vk_sync *sync,
+                     uint32_t syncobj_handle, uint32_t *queue_id_out,
+                     uint32_t *fence_out)
+{
+   uintptr_t sync_ptr = (uintptr_t)sync;
+   uint32_t slot = ((sync_ptr >> 6) ^ (sync_ptr >> 13)) &
+                   (TU_FENCE_HINT_SLOTS - 1);
+
+   for (unsigned retries = 0; retries < 4; retries++) {
+      uint32_t s1 = __atomic_load_n(&dev->fence_hints[slot].seq, __ATOMIC_ACQUIRE);
+      if (s1 & 1)
+         continue;
+
+      uintptr_t ptr = dev->fence_hints[slot].sync_ptr;
+      uint32_t handle = dev->fence_hints[slot].syncobj_handle;
+      uint32_t qid = dev->fence_hints[slot].queue_id;
+      uint32_t fence = dev->fence_hints[slot].fence;
+      __atomic_thread_fence(__ATOMIC_ACQUIRE);
+
+      if (__atomic_load_n(&dev->fence_hints[slot].seq, __ATOMIC_RELAXED) == s1) {
+         if (ptr == sync_ptr && handle == syncobj_handle && qid != 0) {
+            *queue_id_out = qid;
+            *fence_out = fence;
+            return true;
+         }
+         return false;
+      }
+   }
+
+   return false;
