+   int32_t overall_max_half = 0;
+   foreach_block (block, &ir->block_list) {
+      occ_init_block_tracker(&t, block);
+      foreach_instr (instr, &block->instr_list)
+         occ_exec_instr(&t, instr);
+      if (t.max_live_half > overall_max_half)
+         overall_max_half = t.max_live_half;
+   }
+
+   unsigned cur_vecs = DIV_ROUND_UP((unsigned)overall_max_half, 8);
+   if (cur_vecs == 0) {
+      ralloc_free(mem_ctx);
+      return progress;
+   }
+
+   bool dbl = ir3_should_double_threadsize(v, cur_vecs);
+   unsigned indep_waves = ir3_get_reg_independent_max_waves(v, dbl);
+   unsigned max_hw_waves = MIN2(indep_waves, v->compiler->info->max_waves);
+   unsigned cur_waves =
+      MIN2(indep_waves,
+           ir3_get_reg_dependent_max_waves(v->compiler, cur_vecs, dbl));
+
+   if (cur_waves >= max_hw_waves) {
+      ralloc_free(mem_ctx);
+      return progress;
+   }
+
+   unsigned tier1_vecs = 0, tier1_waves = cur_waves;
+   unsigned tier2_vecs = 0, tier2_waves = cur_waves;
+   unsigned min_tv = cur_vecs > 6 ? cur_vecs - 6 : 1;
+   for (unsigned tv = cur_vecs - 1; tv >= min_tv; tv--) {
+      if (ir3_should_double_threadsize(v, tv) != dbl)
+         break;
+      unsigned w =
+         MIN2(indep_waves,
+              ir3_get_reg_dependent_max_waves(v->compiler, tv, dbl));
+      if (!tier1_vecs && w > cur_waves) {
+         tier1_vecs = tv;
+         tier1_waves = w;
+      } else if (tier1_vecs && !tier2_vecs && w > tier1_waves) {
+         tier2_vecs = tv;
+         tier2_waves = w;
+      }
+      if (tv == 1)
+         break;
+   }
+
+   if (!tier1_vecs) {
+      ralloc_free(mem_ctx);
+      return progress;
+   }
+
+   foreach_block (block, &ir->block_list) {
+      unsigned tex_cnt = 0;
+      foreach_instr (instr, &block->instr_list) {
+         if (is_tex(instr))
+            tex_cnt++;
+      }
+
+      unsigned target_vecs =
+         (tex_cnt >= 4 && tier2_vecs > 0) ? tier2_vecs : tier1_vecs;
+      int32_t limit_half = (int32_t)(target_vecs * 8);
+      int32_t trigger_half =
+         (tex_cnt >= 4) ? MAX2(8, limit_half - 16) : MAX2(8, limit_half - 6);
+
+      occ_init_block_tracker(&t, block);
+
+      struct list_head *cur_node = block->instr_list.next;
+      while (cur_node != &block->instr_list) {
+         struct ir3_instruction *cur =
+            list_entry(cur_node, struct ir3_instruction, node);
+
+         if (t.live_half > trigger_half && !occ_stops_lookahead(cur) &&
+             !is_meta(cur) && cur->rpt_prev == NULL) {
+            unsigned steps = 0;
+            bool pulled = false;
+            for (struct list_head *look = cur->node.next;
+                 look != &block->instr_list && steps < 96;
+                 look = look->next, steps++) {
+               struct ir3_instruction *cand =
+                  list_entry(look, struct ir3_instruction, node);
+               if (occ_stops_lookahead(cand))
+                  break;
+               if (occ_try_pull_before(&t, block, cur, cand)) {
+                  pulled = true;
+                  progress = true;
+                  break;
+               }
+            }
+            if (pulled)
+               continue;
+         }
+
+         cur_node = cur->node.next;
+         occ_exec_instr(&t, cur);
+      }
+   }
+
+   ralloc_free(mem_ctx);
+   return progress;
+}
