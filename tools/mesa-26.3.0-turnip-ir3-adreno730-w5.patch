+/* Steer unrestricted high-rate Vulkan submit/wait threads off slow in-order
+ * little cores (CPUs 0-3 on asymmetric big.LITTLE SoCs like sm8450) onto the
+ * high-clock out-of-order core(s), while strictly preserving any explicit
+ * affinity set via taskset or the application.
+ */
+static uint32_t tu_perf_cpu_mask_state; /* 0 = uninit, 1 = disabled, >=2 = (mask << 2) | 2 */
+
+static uint32_t
+tu_read_sysfs_u32(const char *path)
+{
+   int fd = open(path, O_RDONLY | O_CLOEXEC);
+   if (fd < 0)
+      return 0;
+   char buf[32] = {};
+   ssize_t n = read(fd, buf, sizeof(buf) - 1);
+   close(fd);
+   return n > 0 ? (uint32_t)strtoul(buf, NULL, 10) : 0;
+}
+
+static uint32_t
+tu_get_perf_cpu_mask(void)
+{
+   uint32_t st = __atomic_load_n(&tu_perf_cpu_mask_state, __ATOMIC_ACQUIRE);
+   if (likely(st != 0))
+      return (st & 2) ? (st >> 2) : 0;
+
+   uint32_t mask = 0;
+   const char *env = getenv("TU_PERF_MASK");
+   if (env) {
+      mask = (uint32_t)strtoul(env, NULL, 0);
+   } else {
+      uint32_t f0 = tu_read_sysfs_u32("/sys/devices/system/cpu/cpu0/cpufreq/cpuinfo_max_freq");
+      uint32_t f7 = tu_read_sysfs_u32("/sys/devices/system/cpu/cpu7/cpufreq/cpuinfo_max_freq");
+      if (f0 > 0 && f7 > f0)
+         mask = 0x80u; /* Prime core (CPU 7, co-located with gpu-irq & 1MB L2) */
+   }
+
+   uint32_t next_st = mask ? ((mask << 2) | 2u) : 1u;
+   __atomic_store_n(&tu_perf_cpu_mask_state, next_st, __ATOMIC_RELEASE);
+   return mask;
+}
+
+static inline void
+tu_maybe_steer_perf_thread(void)
+{
+   static thread_local uint8_t tls_calls;
+   if (likely(tls_calls >= 8))
+      return;
+   if (++tls_calls < 8)
+      return;
+
+   uint32_t mask = tu_get_perf_cpu_mask();
+   if (!mask)
+      return;
+
+   cpu_set_t cur;
+   CPU_ZERO(&cur);
+   if (sched_getaffinity(0, sizeof(cur), &cur) != 0)
+      return;
+
+   /* Only steer if the thread currently has the default all-8-cores mask,
+    * never overriding explicit taskset or app-pinned threads.
+    */
+   if (CPU_COUNT(&cur) < 8 || !CPU_ISSET(0, &cur) || !CPU_ISSET(7, &cur))
+      return;
+
+   cpu_set_t target;
+   CPU_ZERO(&target);
+   for (unsigned c = 0; c < 32; c++) {
+      if ((mask & (1u << c)) && CPU_ISSET(c, &cur))
+         CPU_SET(c, &target);
+   }
+   if (CPU_COUNT(&target) > 0)
+      sched_setaffinity(0, sizeof(target), &target);
+}
+
+#define TU_TL_HINT_SLOTS 64
+#define TU_TL_RECENT_POINTS 16
+struct tu_tl_sync_state {
+   uint32_t seq;
+   struct tu_device *dev;
+   uintptr_t sync_ptr;
+   uint32_t syncobj_handle;
+   uint32_t queue_id; /* UINT32_MAX = multi-queue */
+   uint32_t head;
+   bool has_untracked;
+   uint64_t max_point;
+   uint32_t max_fence;
+   struct {
+      uint64_t point;
+      uint32_t fence;
+   } recent[TU_TL_RECENT_POINTS];
+};
+static struct tu_tl_sync_state tu_tl_hints[TU_TL_HINT_SLOTS];
+static uint32_t tu_tl_hint_wr_lock;
+
+static inline uint32_t
+tu_tl_hint_slot(uintptr_t sync_ptr)
+{
+   return (uint32_t)(((sync_ptr >> 6) ^ (sync_ptr >> 13)) & (TU_TL_HINT_SLOTS - 1));
+}
+
+static void
+tu_invalidate_tl_hint(struct tu_device *dev, struct vk_sync *sync,
+                      bool keep_queue, uint64_t drop_point)
+{
+   if (!sync)
+      return;
+   uintptr_t sync_ptr = (uintptr_t)sync;
+   uint32_t slot = tu_tl_hint_slot(sync_ptr);
+   if (__atomic_load_n(&tu_tl_hints[slot].sync_ptr, __ATOMIC_RELAXED) != sync_ptr)
+      return;
+
+   struct tu_tl_sync_state *h = &tu_tl_hints[slot];
+   while (__atomic_exchange_n(&tu_tl_hint_wr_lock, 1, __ATOMIC_ACQUIRE))
+      ;
+   if (h->dev == dev && h->sync_ptr == sync_ptr) {
+      uint32_t s = __atomic_load_n(&h->seq, __ATOMIC_RELAXED);
+      __atomic_store_n(&h->seq, s + 1, __ATOMIC_RELEASE);
+      if (keep_queue) {
+         h->has_untracked = true;
+         if (drop_point != 0) {
+            for (uint32_t k = 0; k < TU_TL_RECENT_POINTS; k++) {
+               if (h->recent[k].point == drop_point) {
+                  h->recent[k].point = 0;
+                  h->recent[k].fence = 0;
+               }
+            }
+         } else {
+            memset(h->recent, 0, sizeof(h->recent));
+         }
+      } else {
+         h->dev = NULL;
+         h->sync_ptr = 0;
+         h->syncobj_handle = 0;
+         h->queue_id = 0;
+         h->head = 0;
+         h->has_untracked = false;
+         h->max_point = 0;
+         h->max_fence = 0;
+         memset(h->recent, 0, sizeof(h->recent));
+      }
+      __atomic_store_n(&h->seq, s + 2, __ATOMIC_RELEASE);
+   }
+   __atomic_store_n(&tu_tl_hint_wr_lock, 0, __ATOMIC_RELEASE);
+}
+
+static void
+tu_record_tl_hint(struct tu_device *dev, struct vk_sync *sync, uint32_t handle,
+                  uint64_t point, uint32_t queue_id, uint32_t fence)
+{
+   if (point == 0 || queue_id == 0 || queue_id == UINT32_MAX)
+      return;
+
+   uintptr_t sync_ptr = (uintptr_t)sync;
+   uint32_t slot = tu_tl_hint_slot(sync_ptr);
+   struct tu_tl_sync_state *h = &tu_tl_hints[slot];
+   while (__atomic_exchange_n(&tu_tl_hint_wr_lock, 1, __ATOMIC_ACQUIRE))
+      ;
+   uint32_t s = __atomic_load_n(&h->seq, __ATOMIC_RELAXED);
+   __atomic_store_n(&h->seq, s + 1, __ATOMIC_RELEASE);
+   if (h->dev == dev && h->sync_ptr == sync_ptr && h->syncobj_handle == handle) {
+      if (h->queue_id == UINT32_MAX ||
+          (h->queue_id != 0 && h->queue_id != queue_id)) {
+         h->queue_id = UINT32_MAX;
+         h->has_untracked = true;
+         h->max_point = 0;
+         h->max_fence = 0;
+         memset(h->recent, 0, sizeof(h->recent));
+      } else {
+         h->queue_id = queue_id;
+         uint32_t idx = h->head++ & (TU_TL_RECENT_POINTS - 1);
+         h->recent[idx].point = point;
+         h->recent[idx].fence = fence;
+         if (point >= h->max_point) {
+            h->max_point = point;
+            h->max_fence = fence;
+         }
+      }
+   } else {
+      h->dev = dev;
+      h->sync_ptr = sync_ptr;
+      h->syncobj_handle = handle;
+      h->queue_id = queue_id;
+      h->head = 1;
+      h->has_untracked = false;
+      h->max_point = point;
+      h->max_fence = fence;
+      memset(h->recent, 0, sizeof(h->recent));
+      h->recent[0].point = point;
+      h->recent[0].fence = fence;
+   }
+   __atomic_store_n(&h->seq, s + 2, __ATOMIC_RELEASE);
+   __atomic_store_n(&tu_tl_hint_wr_lock, 0, __ATOMIC_RELEASE);
+}
+
+static bool
+tu_lookup_tl_hint(struct tu_device *dev, struct vk_sync *sync, uint32_t handle,
+                  uint64_t point, uint32_t *qid_out, uint32_t *fence_out)
+{
+   if (point == 0)
+      return false;
+
+   uintptr_t sync_ptr = (uintptr_t)sync;
+   uint32_t slot = tu_tl_hint_slot(sync_ptr);
+   struct tu_tl_sync_state *h = &tu_tl_hints[slot];
+
+   for (unsigned retries = 0; retries < 4; retries++) {
+      uint32_t s1 = __atomic_load_n(&h->seq, __ATOMIC_ACQUIRE);
+      if (s1 & 1)
+         continue;
+
+      struct tu_device *h_dev = h->dev;
+      uintptr_t h_ptr = h->sync_ptr;
+      uint32_t h_handle = h->syncobj_handle;
+      uint32_t h_qid = h->queue_id;
+      bool found = false;
+      uint32_t found_fence = 0;
+      if (h_dev == dev && h_ptr == sync_ptr && h_handle == handle &&
+          h_qid != 0 && h_qid != UINT32_MAX) {
+         for (uint32_t k = 0; k < TU_TL_RECENT_POINTS; k++) {
+            if (h->recent[k].point == point) {
+               found = true;
+               found_fence = h->recent[k].fence;
+               break;
+            }
+         }
+      }
+      __atomic_thread_fence(__ATOMIC_ACQUIRE);
+      if (__atomic_load_n(&h->seq, __ATOMIC_RELAXED) == s1) {
+         if (found) {
+            *qid_out = h_qid;
+            *fence_out = found_fence;
+            return true;
+         }
+         return false;
+      }
+   }
+
+   return false;
+}
+
+static void
+tu_clear_device_hints(struct tu_device *dev)
+{
+   while (__atomic_exchange_n(&tu_copy_hint_wr_lock, 1, __ATOMIC_ACQUIRE))
+      ;
+   for (uint32_t i = 0; i < TU_COPY_HINT_SLOTS; i++) {
+      struct tu_copy_fence_hint *h = &tu_copy_fence_hints[i];
+      if (h->dev == dev) {
+         uint32_t s = __atomic_load_n(&h->seq, __ATOMIC_RELAXED);
+         __atomic_store_n(&h->seq, s + 1, __ATOMIC_RELEASE);
+         h->dev = NULL;
+         h->sync_ptr = 0;
+         h->syncobj_handle = 0;
+         h->queue_id = 0;
+         h->fence = 0;
+         __atomic_store_n(&h->seq, s + 2, __ATOMIC_RELEASE);
+      }
+   }
+   __atomic_store_n(&tu_copy_hint_wr_lock, 0, __ATOMIC_RELEASE);
+
+   while (__atomic_exchange_n(&tu_tl_hint_wr_lock, 1, __ATOMIC_ACQUIRE))
+      ;
+   for (uint32_t i = 0; i < TU_TL_HINT_SLOTS; i++) {
+      struct tu_tl_sync_state *h = &tu_tl_hints[i];
+      if (h->dev == dev) {
+         uint32_t s = __atomic_load_n(&h->seq, __ATOMIC_RELAXED);
+         __atomic_store_n(&h->seq, s + 1, __ATOMIC_RELEASE);
+         h->dev = NULL;
+         h->sync_ptr = 0;
+         h->syncobj_handle = 0;
+         h->queue_id = 0;
+         h->head = 0;
+         h->has_untracked = false;
+         h->max_point = 0;
+         h->max_fence = 0;
+         memset(h->recent, 0, sizeof(h->recent));
+         __atomic_store_n(&h->seq, s + 2, __ATOMIC_RELEASE);
+      }
+   }
+   __atomic_store_n(&tu_tl_hint_wr_lock, 0, __ATOMIC_RELEASE);
+
+   while (__atomic_exchange_n(&tu_q_done_wr_lock, 1, __ATOMIC_ACQUIRE))
+      ;
+   for (uint32_t i = 0; i < TU_Q_DONE_SLOTS; i++) {
+      struct tu_queue_done_entry *e = &tu_q_done[i];
+      if (e->dev == dev) {
+         uint32_t s = __atomic_load_n(&e->seq, __ATOMIC_RELAXED);
+         __atomic_store_n(&e->seq, s + 1, __ATOMIC_RELEASE);
+         e->dev = NULL;
+         e->queue_id = 0;
+         e->completed_fence = 0;
+         __atomic_store_n(&e->seq, s + 2, __ATOMIC_RELEASE);
+      }
+   }
+   __atomic_store_n(&tu_q_done_wr_lock, 0, __ATOMIC_RELEASE);
+}
+
+static bool
+tu_tl_is_point_materialized(struct tu_device *dev, struct vk_sync *sync,
+                            uint32_t handle, uint64_t point)
+{
+   if (point == 0)
+      return true;
+   uintptr_t sync_ptr = (uintptr_t)sync;
+   struct tu_tl_sync_state *h = &tu_tl_hints[tu_tl_hint_slot(sync_ptr)];
+   for (unsigned retries = 0; retries < 4; retries++) {
+      uint32_t s1 = __atomic_load_n(&h->seq, __ATOMIC_ACQUIRE);
+      if (s1 & 1)
+         continue;
+      struct tu_device *h_dev = h->dev;
+      uintptr_t h_ptr = h->sync_ptr;
+      uint32_t h_handle = h->syncobj_handle;
+      uint32_t h_qid = h->queue_id;
+      uint64_t max_pt = h->max_point;
+      __atomic_thread_fence(__ATOMIC_ACQUIRE);
+      if (__atomic_load_n(&h->seq, __ATOMIC_RELAXED) == s1) {
+         return h_dev == dev && h_ptr == sync_ptr && h_handle == handle &&
+                h_qid != 0 && h_qid != UINT32_MAX && max_pt >= point;
+      }
+   }
+   return false;
+}
