+VKAPI_ATTR VkResult VKAPI_CALL
+tu_GetFenceStatus(VkDevice _device, VkFence _fence)
+{
+   VK_FROM_HANDLE(tu_device, dev, _device);
+   VK_FROM_HANDLE(vk_fence, fence, _fence);
+
+   if (unlikely(vk_device_is_lost(&dev->vk)))
+      return VK_ERROR_DEVICE_LOST;
+
+   if (dev->instance->knl->name[0] == 'm') {
+      struct vk_sync *sync = vk_fence_get_active_sync(fence);
+      if (sync == &fence->permanent && vk_sync_type_is_drm_syncobj(sync->type)) {
+         uint32_t qid = 0, msm_fence = 0;
+         if (tu_lookup_any_fence_hint(dev, sync,
+                                      vk_sync_as_drm_syncobj(sync)->syncobj,
+                                      &qid, &msm_fence)) {
+            int r = tu_msm_peek_fence(dev, qid, msm_fence);
+            if (r == 0)
+               return VK_SUCCESS;
+            if (r == -ETIMEDOUT)
+               return VK_NOT_READY;
+         }
+      }
+   }
+
+   return vk_common_GetFenceStatus(_device, _fence);
+}
