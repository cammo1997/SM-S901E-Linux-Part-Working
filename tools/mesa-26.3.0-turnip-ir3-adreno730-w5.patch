+
+static bool
+occ_is_kept_in_block(const struct ir3_block *block,
+                     const struct ir3_instruction *instr)
+{
+   for (unsigned i = 0; i < block->keeps_count; i++) {
+      if (block->keeps[i] == instr)
+         return true;
+   }
+   return false;
+}
+
+static bool
+occ_is_pure_movable_alu(struct ir3_instruction *instr)
+{
+   unsigned cat = opc_cat(instr->opc);
+   if (cat < 1 || cat > 4)
+      return false;
+   if (cat == 1 && instr->opc != OPC_MOV)
+      return false;
+
+   if (is_input(instr) || is_subgroup_cond_mov_macro(instr))
+      return false;
+
+   if (instr->barrier_class || instr->barrier_conflict || instr->address)
+      return false;
+
+   if (instr->flags & IR3_INSTR_EQ)
+      return false;
+
+   if (instr->dsts_count != 1 || has_dummy_dst(instr))
+      return false;
+
+   struct ir3_register *dst = instr->dsts[0];
+   if (!ra_reg_is_dst(dst))
+      return false;
+
+   if (dst->flags & (IR3_REG_ARRAY | IR3_REG_SHARED | IR3_REG_RELATIV |
+                     IR3_REG_PREDICATE | IR3_REG_EI))
+      return false;
+
+   foreach_src (src, instr) {
+      if (src->flags & (IR3_REG_ARRAY | IR3_REG_SHARED | IR3_REG_RELATIV |
+                        IR3_REG_PREDICATE))
+         return false;
+      if (!(src->flags & (IR3_REG_IMMED | IR3_REG_CONST | IR3_REG_SSA)))
+         return false;
+      if ((src->flags & IR3_REG_SSA) && src->def && reg_num(src->def) == REG_A0)
+         return false;
+   }
+
+   return true;
+}
+
+/* Sink pure post-discard ALU instructions past OPC_KILL so discarded fragments
+ * avoid unnecessary ALU work and pre/post-kill temporaries don't overlap.
+ */
+static bool
+occ_sink_past_kill(struct ir3 *ir, struct ir3_shader_variant *v)
+{
+   if (v->type != MESA_SHADER_FRAGMENT)
+      return false;
+
+   void *mem_ctx = ralloc_context(NULL);
+   struct ir3_liveness *live = ir3_calc_liveness(mem_ctx, ir);
+   if (!live->definitions_count) {
+      ralloc_free(mem_ctx);
+      return false;
+   }
+
+   BITSET_WORD *need = BITSET_RZALLOC(mem_ctx, live->definitions_count);
+   bool progress = false;
+
+   foreach_block (block, &ir->block_list) {
+      struct ir3_instruction *first_kill = NULL;
+      bool has_demote = false;
+
+      foreach_instr (instr, &block->instr_list) {
+         if (instr->opc == OPC_DEMOTE) {
+            has_demote = true;
+            break;
+         }
+         if (instr->opc == OPC_KILL && !first_kill)
+            first_kill = instr;
+      }
+
+      if (!first_kill || has_demote)
+         continue;
+
+      memset(need, 0, BITSET_WORDS(live->definitions_count) * sizeof(*need));
+      foreach_src (src, first_kill) {
+         if (ra_reg_is_src(src))
+            BITSET_SET(need, src->def->name);
+      }
+
+      struct list_head *pos = first_kill->node.prev;
+      while (pos != &block->instr_list) {
+         struct list_head *prev_pos = pos->prev;
+         struct ir3_instruction *instr =
+            list_entry(pos, struct ir3_instruction, node);
+
+         if (occ_is_pure_movable_alu(instr) &&
+             !occ_is_kept_in_block(block, instr) &&
+             !BITSET_TEST(need, instr->dsts[0]->name)) {
+            list_del(&instr->node);
+            list_add(&instr->node, &first_kill->node);
+            progress = true;
+         } else {
+            foreach_src (src, instr) {
+               if (ra_reg_is_src(src))
+                  BITSET_SET(need, src->def->name);
+            }
+         }
+
+         pos = prev_pos;
+      }
+   }
+
+   ralloc_free(mem_ctx);
+   return progress;
+}
+
+struct occ_split_children {
+   struct ir3_register *child[4];
+   uint8_t count;
+};
+
+struct occ_tracker {
+   const struct ir3_liveness *live;
+   uint32_t defs_count;
+   uint32_t *rem_uses;
+   uint16_t *active_weight;
+   bool *defined;
+   bool *is_live;
+   struct occ_split_children *splits;
+   int32_t live_half;
+   int32_t max_live_half;
+};
+
+static bool
+occ_track_gpr(const struct ir3_register *reg)
+{
+   return (reg->flags & IR3_REG_SSA) && def_is_gpr(reg) &&
+          !(reg->flags & IR3_REG_SHARED);
+}
+
+static void
+occ_kill_def(struct occ_tracker *t, struct ir3_register *def)
+{
+   unsigned name = def->name;
+   if (!t->is_live[name])
+      return;
+
+   t->is_live[name] = false;
+   t->live_half -= t->active_weight[name];
+   t->active_weight[name] = 0;
+
+   struct occ_split_children *sc = &t->splits[name];
+   for (unsigned i = 0; i < sc->count; i++) {
+      struct ir3_register *c = sc->child[i];
+      unsigned cname = c->name;
+      if (t->is_live[cname] && t->active_weight[cname] == 0) {
+         t->active_weight[cname] = (uint16_t)reg_size(c);
+         t->live_half += t->active_weight[cname];
+      }
+   }
+   if (t->live_half > t->max_live_half)
+      t->max_live_half = t->live_half;
+}
+
+static void
+occ_exec_instr(struct occ_tracker *t, struct ir3_instruction *instr)
+{
+   foreach_src (src, instr) {
+      if (!ra_reg_is_src(src))
+         continue;
+      unsigned sname = src->def->name;
+      if (t->rem_uses[sname] > 0) {
+         t->rem_uses[sname]--;
+         if (t->rem_uses[sname] == 0)
+            occ_kill_def(t, src->def);
+      }
+   }
+
+   foreach_dst (dst, instr) {
+      if (!(dst->flags & IR3_REG_SSA))
+         continue;
+      unsigned dname = dst->name;
+      t->defined[dname] = true;
+
+      if (!occ_track_gpr(dst) || t->rem_uses[dname] == 0)
+         continue;
+
+      t->is_live[dname] = true;
+      if (instr->opc == OPC_META_SPLIT) {
+         struct ir3_register *p = instr->srcs[0]->def;
+         if (p && (p->flags & IR3_REG_SSA) && t->is_live[p->name]) {
+            struct occ_split_children *sc = &t->splits[p->name];
+            if (sc->count < 4)
+               sc->child[sc->count++] = dst;
+            t->active_weight[dname] = 0;
+            continue;
+         }
+      }
+      t->active_weight[dname] = (uint16_t)reg_size(dst);
+      t->live_half += t->active_weight[dname];
+   }
+
+   if (t->live_half > t->max_live_half)
+      t->max_live_half = t->live_half;
+}
+
+static void
+occ_init_block_tracker(struct occ_tracker *t, struct ir3_block *block)
+{
+   memset(t->rem_uses, 0, t->defs_count * sizeof(*t->rem_uses));
+   memset(t->active_weight, 0, t->defs_count * sizeof(*t->active_weight));
+   memset(t->defined, 0, t->defs_count * sizeof(*t->defined));
+   memset(t->is_live, 0, t->defs_count * sizeof(*t->is_live));
+   memset(t->splits, 0, t->defs_count * sizeof(*t->splits));
+   t->live_half = 0;
+   t->max_live_half = 0;
+
+   unsigned name;
+   BITSET_FOREACH_SET (name, t->live->live_in[block->index], t->defs_count) {
+      struct ir3_register *def = t->live->definitions[name];
+      t->defined[name] = true;
+      if (occ_track_gpr(def)) {
+         t->is_live[name] = true;
+         t->active_weight[name] = (uint16_t)reg_size(def);
+         t->live_half += t->active_weight[name];
+      }
+   }
+
+   BITSET_FOREACH_SET (name, t->live->live_out[block->index], t->defs_count) {
+      t->rem_uses[name]++;
+   }
+
+   foreach_instr (instr, &block->instr_list) {
+      foreach_src (src, instr) {
+         if (ra_reg_is_src(src))
+            t->rem_uses[src->def->name]++;
+      }
+   }
+
+   t->max_live_half = t->live_half;
+}
+
+static bool
+occ_stops_lookahead(struct ir3_instruction *instr)
+{
+   if (opc_cat(instr->opc) == 0 || is_kill_or_demote(instr) ||
+       is_barrier(instr) || is_store(instr))
+      return true;
+   if (instr->barrier_class & (IR3_BARRIER_EVERYTHING |
+                               IR3_BARRIER_ACTIVE_FIBERS_W |
+                               IR3_BARRIER_IMAGE_W |
+                               IR3_BARRIER_BUFFER_W |
+                               IR3_BARRIER_SHARED_W |
+                               IR3_BARRIER_ARRAY_W |
+                               IR3_BARRIER_PRIVATE_W))
+      return true;
+   return false;
+}
+
+static bool
+occ_instr_srcs_ready(const struct occ_tracker *t,
+                     const struct ir3_block *block,
+                     struct ir3_instruction *cand,
+                     struct ir3_instruction *const *group,
+                     unsigned group_len,
+                     struct ir3_instruction **need_splits,
+                     unsigned *need_splits_count,
+                     unsigned max_splits)
+{
+   foreach_src (src, cand) {
+      if (!ra_reg_is_src(src))
+         continue;
+
+      struct ir3_register *def = src->def;
+      if (t->defined[def->name])
+         continue;
+
+      bool in_group = false;
+      for (unsigned g = 0; g < group_len; g++) {
+         if (group[g] == def->instr) {
+            in_group = true;
+            break;
+         }
+      }
+      if (in_group)
+         continue;
+
+      /* Also allow pulling a ready OPC_META_SPLIT whose parent is defined. */
+      struct ir3_instruction *di = def->instr;
+      if (di->opc == OPC_META_SPLIT && di->block == block &&
+          ra_reg_is_src(di->srcs[0]) && t->defined[di->srcs[0]->def->name] &&
+          !(di->dsts[0]->flags & (IR3_REG_SHARED | IR3_REG_ARRAY))) {
+         bool already = false;
+         for (unsigned s = 0; s < *need_splits_count; s++) {
+            if (need_splits[s] == di) {
+               already = true;
+               break;
+            }
+         }
+         if (!already) {
+            if (*need_splits_count >= max_splits)
+               return false;
+            need_splits[(*need_splits_count)++] = di;
+         }
+         continue;
+      }
+
+      return false;
+   }
+   return true;
+}
+
+static bool
+occ_try_pull_before(struct occ_tracker *t, struct ir3_block *block,
+                    struct ir3_instruction *cur, struct ir3_instruction *cand)
+{
+   if (cand->rpt_prev != NULL)
+      return false;
+
+   struct ir3_instruction *group[8];
+   unsigned group_len = 0;
+   for (struct ir3_instruction *g = cand; g && group_len < ARRAY_SIZE(group);
+        g = g->rpt_next) {
+      if (g->block != block || !occ_is_pure_movable_alu(g) ||
+          occ_is_kept_in_block(block, g))
+         return false;
+
+      /* Verify group members appear strictly in order after cur without barriers. */
+      if (g != cand) {
+         if (g == cur)
+            return false;
+         bool seen = false;
+         for (struct ir3_instruction *m =
+                 list_entry(group[group_len - 1]->node.next,
+                            struct ir3_instruction, node);
+              &m->node != &block->instr_list;
+              m = list_entry(m->node.next, struct ir3_instruction, node)) {
+            if (m == g) {
+               seen = true;
+               break;
+            }
+            if (occ_stops_lookahead(m))
+               return false;
+         }
+         if (!seen)
+            return false;
+      }
+      group[group_len++] = g;
+   }
+   if (group[group_len - 1]->rpt_next != NULL)
+      return false;
+
+   struct ir3_instruction *need_splits[32];
+   unsigned need_splits_count = 0;
+   for (unsigned i = 0; i < group_len; i++) {
+      if (!occ_instr_srcs_ready(t, block, group[i], group, i,
+                                need_splits, &need_splits_count,
+                                ARRAY_SIZE(need_splits)))
+         return false;
+   }
+
+   /* Verify no unmoved split sits at/before cur or past a barrier from cur. */
+   for (unsigned s = 0; s < need_splits_count; s++) {
+      if (need_splits[s] == cur)
+         return false;
+      bool reached = false;
+      for (struct ir3_instruction *m = list_entry(cur->node.next, struct ir3_instruction, node);
+           &m->node != &block->instr_list;
+           m = list_entry(m->node.next, struct ir3_instruction, node)) {
+         if (m == need_splits[s]) {
+            reached = true;
+            break;
+         }
+         if (occ_stops_lookahead(m))
+            return false;
+      }
+      if (!reached)
+         return false;
+   }
+
+   /* Compute net scalar pressure delta if this group executes before cur. */
+   struct ir3_register *seen_srcs[32];
+   uint32_t seen_uses[32];
+   unsigned n_srcs = 0;
+   int32_t produced = 0;
+
+   for (unsigned i = 0; i < group_len; i++) {
+      produced += (int32_t)reg_size(group[i]->dsts[0]);
+      foreach_src (src, group[i]) {
+         if (!ra_reg_is_src(src) || !occ_track_gpr(src->def))
+            continue;
+         bool is_grp_def = false;
+         for (unsigned j = 0; j < i; j++) {
+            if (group[j]->dsts[0] == src->def) {
+               is_grp_def = true;
+               break;
+            }
+         }
+         if (is_grp_def) {
+            produced -= (int32_t)reg_size(src->def);
+            continue;
+         }
+         unsigned idx = 0;
+         for (; idx < n_srcs; idx++) {
+            if (seen_srcs[idx] == src->def) {
+               seen_uses[idx]++;
+               break;
+            }
+         }
+         if (idx == n_srcs) {
+            if (n_srcs >= ARRAY_SIZE(seen_srcs))
+               return false;
+            seen_srcs[n_srcs] = src->def;
+            seen_uses[n_srcs++] = 1;
+         }
+      }
+   }
+
+   int32_t killed = 0;
+   for (unsigned idx = 0; idx < n_srcs; idx++) {
+      if (t->rem_uses[seen_srcs[idx]->name] == seen_uses[idx])
+         killed += (int32_t)reg_size(seen_srcs[idx]);
+   }
+
+   if (produced >= killed)
+      return false;
+
+   for (unsigned s = 0; s < need_splits_count; s++) {
+      struct ir3_instruction *sp = need_splits[s];
+      list_del(&sp->node);
+      list_addtail(&sp->node, &cur->node);
+      occ_exec_instr(t, sp);
+   }
+
+   for (unsigned i = 0; i < group_len; i++) {
+      struct ir3_instruction *g = group[i];
+      list_del(&g->node);
+      list_addtail(&g->node, &cur->node);
+      occ_exec_instr(t, g);
+   }
+
+   return true;
+}
+
+bool
+ir3_opt_occupancy(struct ir3 *ir, struct ir3_shader_variant *v)
+{
+   bool progress = occ_sink_past_kill(ir, v);
+
+   if (!v->compiler->mergedregs)
+      return progress;
+
+   void *mem_ctx = ralloc_context(NULL);
+   struct ir3_liveness *live = ir3_calc_liveness(mem_ctx, ir);
+   if (!live->definitions_count) {
+      ralloc_free(mem_ctx);
+      return progress;
+   }
+
+   struct occ_tracker t = {
+      .live = live,
+      .defs_count = live->definitions_count,
