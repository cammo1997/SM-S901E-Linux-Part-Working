+
+VkResult
+tu_msm_copy_sync_payloads(struct vk_device *vk_dev,
+                          uint32_t wait_count,
+                          const struct vk_sync_wait *waits,
+                          uint32_t signal_count,
+                          const struct vk_sync_signal *signals)
+{
+   struct tu_device *dev = container_of(vk_dev, struct tu_device, vk);
+   uint32_t src_qid = 0, src_fence = 0;
+   bool propagate = wait_count > 0 && signal_count > 0;
+   struct vk_sync_wait pruned_waits[16];
+   const struct vk_sync_wait *pass_waits = waits;
+   uint32_t pass_wait_count = wait_count;
+
+   if (wait_count > 0 && wait_count <= ARRAY_SIZE(pruned_waits)) {
+      uint32_t active_n = 0;
+      for (uint32_t i = 0; i < wait_count; i++) {
+         struct vk_sync *sync = waits[i].sync;
+         uint32_t qid = 0, fence = 0;
+         bool ok = false;
+         if (sync && vk_sync_type_is_drm_syncobj(sync->type)) {
+            uint32_t handle = vk_sync_as_drm_syncobj(sync)->syncobj;
+            ok = (sync->flags & VK_SYNC_IS_TIMELINE)
+                    ? tu_lookup_tl_hint(dev, sync, handle, waits[i].wait_value,
+                                        &qid, &fence)
+                    : tu_lookup_any_fence_hint(dev, sync, handle, &qid, &fence);
+         }
+         if (!ok) {
+            propagate = false;
+            pruned_waits[active_n++] = waits[i];
+            continue;
+         }
+         if (propagate) {
+            if (src_qid == 0) {
+               src_qid = qid;
+               src_fence = fence;
+            } else if (src_qid == qid) {
+               if ((int32_t)(fence - src_fence) > 0)
+                  src_fence = fence;
+            } else {
+               propagate = false;
+            }
+         }
+         /* Prune already-completed waits when merging multiple syncobjs so
+          * vk_drm_syncobj_copy_payloads avoids temporary syncobj CREATE/DESTROY
+          * or sync_file HANDLE_TO_FD + SYNC_IOC_MERGE + FD_TO_HANDLE storms.
+          */
+         if (wait_count > 1 && tu_msm_peek_fence(dev, qid, fence) == 0)
+            continue;
+         pruned_waits[active_n++] = waits[i];
+      }
+      pass_waits = pruned_waits;
+      pass_wait_count = active_n;
+   } else if (propagate) {
+      propagate = false;
+   }
+
+   VkResult result = vk_drm_syncobj_copy_payloads(vk_dev, pass_wait_count,
+                                                  pass_waits, signal_count,
+                                                  signals);
+   if (result != VK_SUCCESS)
+      return result;
+
+   for (uint32_t i = 0; i < signal_count; i++) {
+      struct vk_sync *sync = signals[i].sync;
+      if (!sync || !vk_sync_type_is_drm_syncobj(sync->type))
+         continue;
+      uint32_t handle = vk_sync_as_drm_syncobj(sync)->syncobj;
+      if (sync->flags & VK_SYNC_IS_TIMELINE) {
+         if (propagate && src_qid != 0)
+            tu_record_tl_hint(dev, sync, handle, signals[i].signal_value,
+                              src_qid, src_fence);
+         else
+            tu_invalidate_tl_hint(dev, sync, true, signals[i].signal_value);
+         continue;
+      }
+      if (propagate && src_qid != 0)
+         tu_record_copy_hint(dev, sync, handle, src_qid, src_fence);
+      else
+         tu_invalidate_copy_hint(dev, sync);
+   }
+
+   return VK_SUCCESS;
+}
+
+static int
+tu_msm_wait_fence_boost_ns(struct tu_device *dev, uint32_t queue_id,
+                           uint32_t fence, uint64_t spin_ns)
+{
+   if (tu_is_msm_fence_completed(dev, queue_id, fence))
+      return 0;
+
+   struct timespec ts;
+   clock_gettime(CLOCK_MONOTONIC, &ts);
+
+   uint64_t abs_ns = (uint64_t)ts.tv_sec * 1000000000ULL + ts.tv_nsec + spin_ns;
+   struct drm_msm_wait_fence req = {
+      .fence = fence,
+      .flags = MSM_WAIT_FENCE_BOOST,
+      .timeout = {
+         .tv_sec = (int64_t)(abs_ns / 1000000000ULL),
+         .tv_nsec = (int64_t)(abs_ns % 1000000000ULL),
+      },
+      .queueid = queue_id,
+   };
+
+   int ret = drmCommandWrite(dev->fd, DRM_MSM_WAIT_FENCE, &req, sizeof(req));
+   if (ret == 0)
+      tu_mark_msm_fence_completed(dev, queue_id, fence);
+   return ret;
+}
