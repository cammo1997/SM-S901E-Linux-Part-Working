+      return;
+
+   while (__atomic_exchange_n(&dev->fence_hint_wr_lock, 1, __ATOMIC_ACQUIRE))
+      ;
+   if (dev->fence_hints[slot].sync_ptr == sync_ptr) {
+      uint32_t s = __atomic_load_n(&dev->fence_hints[slot].seq, __ATOMIC_RELAXED);
+      __atomic_store_n(&dev->fence_hints[slot].seq, s + 1, __ATOMIC_RELEASE);
+      dev->fence_hints[slot].sync_ptr = 0;
+      dev->fence_hints[slot].syncobj_handle = 0;
+      dev->fence_hints[slot].queue_id = 0;
+      dev->fence_hints[slot].fence = 0;
+      __atomic_store_n(&dev->fence_hints[slot].seq, s + 2, __ATOMIC_RELEASE);
+   }
+   __atomic_store_n(&dev->fence_hint_wr_lock, 0, __ATOMIC_RELEASE);
+}
