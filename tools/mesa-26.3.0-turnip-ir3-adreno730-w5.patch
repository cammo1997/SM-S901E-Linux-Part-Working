+static bool
+tu_is_msm_fence_completed(struct tu_device *dev, uint32_t qid, uint32_t fence)
+{
+   if (qid == 0 || fence == 0)
+      return false;
+   struct tu_queue_done_entry *e = &tu_q_done[tu_q_done_slot(dev, qid)];
+   for (unsigned retries = 0; retries < 4; retries++) {
+      uint32_t s1 = __atomic_load_n(&e->seq, __ATOMIC_ACQUIRE);
+      if (s1 & 1)
+         continue;
+      struct tu_device *e_dev = e->dev;
+      uint32_t e_qid = e->queue_id;
+      uint32_t done = e->completed_fence;
+      __atomic_thread_fence(__ATOMIC_ACQUIRE);
+      if (__atomic_load_n(&e->seq, __ATOMIC_RELAXED) == s1) {
+         return e_dev == dev && e_qid == qid && done != 0 &&
+                (int32_t)(fence - done) <= 0;
+      }
+   }
+   return false;
+}
+
+static void
+tu_mark_msm_fence_completed(struct tu_device *dev, uint32_t qid, uint32_t fence)
+{
+   if (qid == 0 || fence == 0)
+      return;
+   struct tu_queue_done_entry *e = &tu_q_done[tu_q_done_slot(dev, qid)];
+   while (__atomic_exchange_n(&tu_q_done_wr_lock, 1, __ATOMIC_ACQUIRE))
+      ;
+   uint32_t s = __atomic_load_n(&e->seq, __ATOMIC_RELAXED);
+   if (e->dev == dev && e->queue_id == qid) {
+      if (e->completed_fence == 0 || (int32_t)(fence - e->completed_fence) > 0) {
+         __atomic_store_n(&e->seq, s + 1, __ATOMIC_RELEASE);
+         e->completed_fence = fence;
+         __atomic_store_n(&e->seq, s + 2, __ATOMIC_RELEASE);
+      }
+   } else {
+      __atomic_store_n(&e->seq, s + 1, __ATOMIC_RELEASE);
+      e->dev = dev;
+      e->queue_id = qid;
+      e->completed_fence = fence;
+      __atomic_store_n(&e->seq, s + 2, __ATOMIC_RELEASE);
+   }
+   __atomic_store_n(&tu_q_done_wr_lock, 0, __ATOMIC_RELEASE);
+}
