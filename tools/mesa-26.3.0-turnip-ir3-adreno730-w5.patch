+/* Returns: 1 = VK_SUCCESS, -1 = proven VK_TIMEOUT (timeout==0), 0 = fallback */
+static int
+tu_wait_msm_syncs(struct tu_device *dev, uint32_t count,
+                  struct vk_sync *const *syncs, const uint64_t *values,
+                  bool is_timeline, bool wait_all, uint64_t *timeout_inout)
+{
+   uint64_t timeout = *timeout_inout;
+   if (count == 0 || count > 16 || (!wait_all && count > 1) ||
+       dev->instance->knl->name[0] != 'm' ||
+       strcmp(dev->instance->knl->name, "msm") != 0)
+      return 0;
+
+   tu_maybe_steer_perf_thread();
+
+   uint32_t last_qid = 0, max_fence = 0, hits = 0;
+   bool single_queue = true;
+   uint32_t qids[16];
+   uint32_t fences[16];
+
+   for (uint32_t i = 0; i < count; i++) {
+      qids[i] = 0;
+      fences[i] = 0;
+      struct vk_sync *sync = syncs[i];
+      if (!sync || !vk_sync_type_is_drm_syncobj(sync->type))
+         continue;
+      bool tl = (sync->flags & VK_SYNC_IS_TIMELINE) != 0;
+      if (tl != is_timeline)
+         continue;
+
+      uint32_t handle = vk_sync_as_drm_syncobj(sync)->syncobj;
+      uint32_t qid = 0, msm_fence = 0;
+      bool ok = is_timeline
+                   ? tu_lookup_tl_hint(dev, sync, handle, values[i], &qid, &msm_fence)
+                   : tu_lookup_any_fence_hint(dev, sync, handle, &qid, &msm_fence);
+      if (!ok)
+         continue;
+
+      qids[i] = qid;
+      fences[i] = msm_fence;
+      hits++;
+      if (last_qid == 0) {
+         last_qid = qid;
+         max_fence = msm_fence;
+      } else if (last_qid == qid) {
+         if ((int32_t)(msm_fence - max_fence) > 0)
+            max_fence = msm_fence;
+      } else {
+         single_queue = false;
+      }
+   }
+
+   if (last_qid == 0)
+      return 0;
+
+   if (single_queue && hits == count) {
+      if (tu_is_msm_fence_completed(dev, last_qid, max_fence))
+         return 1;
+      if (timeout == 0) {
+         int r = tu_msm_peek_fence(dev, last_qid, max_fence);
+         if (r == 0)
+            return 1;
+         if (r == -ETIMEDOUT)
+            return -1;
+         return 0;
+      }
+   } else if (timeout == 0) {
+      return 0;
+   }
+
+   struct timespec t0;
+   uint64_t start_ns = 0;
+   if (timeout != UINT64_MAX) {
+      clock_gettime(CLOCK_MONOTONIC, &t0);
+      start_ns = (uint64_t)t0.tv_sec * 1000000000ULL + t0.tv_nsec;
+   }
+
+   uint64_t full_budget = MIN2(timeout, 50000000ULL);
+   uint64_t probe_budget = MIN2(timeout, 2000000ULL);
+
+   if (!single_queue) {
+      for (uint32_t i = 0; i < count; i++) {
+         if (qids[i] != 0 && qids[i] != last_qid)
+            tu_msm_wait_fence_boost_ns(dev, qids[i], fences[i], probe_budget / 2);
+      }
+   }
+
+   if (single_queue && hits == count) {
+      if (tu_msm_wait_fence_boost_ns(dev, last_qid, max_fence, full_budget) == 0)
+         return 1;
+   } else {
+      tu_msm_wait_fence_boost_ns(dev, last_qid, max_fence,
+                                 single_queue ? probe_budget : probe_budget / 2);
+   }
+
+   if (timeout != UINT64_MAX) {
+      struct timespec t1;
+      clock_gettime(CLOCK_MONOTONIC, &t1);
+      uint64_t end_ns = (uint64_t)t1.tv_sec * 1000000000ULL + t1.tv_nsec;
+      uint64_t elapsed = end_ns > start_ns ? end_ns - start_ns : 0;
+      *timeout_inout = elapsed < timeout ? timeout - elapsed : 0;
+   }
+   return 0;
+}
