+VKAPI_ATTR VkResult VKAPI_CALL
+tu_GetSemaphoreCounterValue(VkDevice _device,
+                            VkSemaphore _semaphore,
+                            uint64_t *pValue)
+{
+   VK_FROM_HANDLE(tu_device, dev, _device);
+   VK_FROM_HANDLE(vk_semaphore, sem, _semaphore);
+
+   if (unlikely(vk_device_is_lost(&dev->vk)))
+      return VK_ERROR_DEVICE_LOST;
+
+   if (dev->instance->knl->name[0] == 'm') {
+      struct vk_sync *sync = vk_semaphore_get_active_sync(sem);
+      if (sync == &sem->permanent && (sync->flags & VK_SYNC_IS_TIMELINE) &&
+          vk_sync_type_is_drm_syncobj(sync->type)) {
+         uintptr_t sync_ptr = (uintptr_t)sync;
+         uint32_t handle = vk_sync_as_drm_syncobj(sync)->syncobj;
+         struct tu_tl_sync_state *h = &tu_tl_hints[tu_tl_hint_slot(sync_ptr)];
+         uint32_t s1 = __atomic_load_n(&h->seq, __ATOMIC_ACQUIRE);
+         if (!(s1 & 1)) {
+            struct tu_device *h_dev = h->dev;
+            uintptr_t h_ptr = h->sync_ptr;
+            uint32_t h_handle = h->syncobj_handle;
+            uint32_t h_qid = h->queue_id;
+            bool untracked = h->has_untracked;
+            uint64_t max_pt = h->max_point;
+            uint32_t max_fn = h->max_fence;
+            __atomic_thread_fence(__ATOMIC_ACQUIRE);
+            if (__atomic_load_n(&h->seq, __ATOMIC_RELAXED) == s1 &&
+                h_dev == dev && h_ptr == sync_ptr && h_handle == handle &&
+                !untracked && h_qid != 0 && h_qid != UINT32_MAX && max_pt > 0) {
+               if (tu_msm_peek_fence(dev, h_qid, max_fn) == 0) {
+                  *pValue = max_pt;
+                  return VK_SUCCESS;
+               }
+            }
+         }
+      }
+   }
+
+   return vk_common_GetSemaphoreCounterValue(_device, _semaphore, pValue);
+}
