+VKAPI_ATTR void VKAPI_CALL
+tu_DestroySemaphore(VkDevice _device,
+                    VkSemaphore _semaphore,
+                    const VkAllocationCallbacks *pAllocator)
+{
+   VK_FROM_HANDLE(tu_device, dev, _device);
+   VK_FROM_HANDLE(vk_semaphore, sem, _semaphore);
+   if (sem)
+      tu_invalidate_tl_hint(dev, &sem->permanent, false, 0);
+   vk_common_DestroySemaphore(_device, _semaphore, pAllocator);
+}
