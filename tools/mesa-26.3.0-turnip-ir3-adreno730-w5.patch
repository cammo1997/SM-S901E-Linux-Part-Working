+VKAPI_ATTR VkResult VKAPI_CALL
+tu_ResetFences(VkDevice _device,
+               uint32_t fenceCount,
+               const VkFence *pFences)
+{
+   VK_FROM_HANDLE(tu_device, dev, _device);
+   for (uint32_t i = 0; i < fenceCount; i++) {
+      VK_FROM_HANDLE(vk_fence, fence, pFences[i]);
+      tu_invalidate_fence_hint(dev, &fence->permanent);
+      tu_invalidate_copy_hint(dev, &fence->permanent);
+   }
+   return vk_common_ResetFences(_device, fenceCount, pFences);
+}
