+VKAPI_ATTR void VKAPI_CALL
+tu_DestroyFence(VkDevice _device,
+                VkFence _fence,
+                const VkAllocationCallbacks *pAllocator)
+{
+   VK_FROM_HANDLE(tu_device, dev, _device);
+   VK_FROM_HANDLE(vk_fence, fence, _fence);
+   if (fence) {
+      tu_invalidate_fence_hint(dev, &fence->permanent);
+      tu_invalidate_copy_hint(dev, &fence->permanent);
+   }
+   vk_common_DestroyFence(_device, _fence, pAllocator);
+}
