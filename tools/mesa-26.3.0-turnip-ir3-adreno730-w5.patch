+VKAPI_ATTR VkResult VKAPI_CALL
+tu_WaitForFences(VkDevice _device,
+                 uint32_t fenceCount,
+                 const VkFence *pFences,
+                 VkBool32 waitAll,
+                 uint64_t timeout)
+{
+   VK_FROM_HANDLE(tu_device, dev, _device);
+
+   if (unlikely(vk_device_is_lost(&dev->vk)))
+      return VK_ERROR_DEVICE_LOST;
+
+   if (fenceCount > 0 && fenceCount <= 16) {
+      struct vk_sync *syncs[16];
+      for (uint32_t i = 0; i < fenceCount; i++) {
+         VK_FROM_HANDLE(vk_fence, fence, pFences[i]);
+         struct vk_sync *sync = vk_fence_get_active_sync(fence);
+         syncs[i] = (sync == &fence->permanent) ? sync : NULL;
+      }
+      int r = tu_wait_msm_syncs(dev, fenceCount, syncs, NULL, false, waitAll, &timeout);
+      if (r > 0)
+         return VK_SUCCESS;
+      if (r < 0)
+         return VK_TIMEOUT;
+   }
+
+   return vk_common_WaitForFences(_device, fenceCount, pFences, waitAll, timeout);
+}
+
+VKAPI_ATTR VkResult VKAPI_CALL
+tu_WaitSemaphores(VkDevice _device,
+                  const VkSemaphoreWaitInfo *pWaitInfo,
+                  uint64_t timeout)
+{
+   VK_FROM_HANDLE(tu_device, dev, _device);
+
+   if (unlikely(vk_device_is_lost(&dev->vk)))
+      return VK_ERROR_DEVICE_LOST;
+
+   uint32_t cnt = pWaitInfo->semaphoreCount;
+   if (cnt > 0 && cnt <= 16) {
+      bool wait_all = !(pWaitInfo->flags & VK_SEMAPHORE_WAIT_ANY_BIT);
+      struct vk_sync *syncs[16];
+      for (uint32_t i = 0; i < cnt; i++) {
+         VK_FROM_HANDLE(vk_semaphore, sem, pWaitInfo->pSemaphores[i]);
+         struct vk_sync *sync = vk_semaphore_get_active_sync(sem);
+         syncs[i] = (sync == &sem->permanent) ? sync : NULL;
+      }
+      int r = tu_wait_msm_syncs(dev, cnt, syncs, pWaitInfo->pValues, true, wait_all, &timeout);
+      if (r > 0)
+         return VK_SUCCESS;
+      if (r < 0)
+         return VK_TIMEOUT;
+   }
+
+   return vk_common_WaitSemaphores(_device, pWaitInfo, timeout);
+}
+
+VKAPI_ATTR VkResult VKAPI_CALL
+tu_SignalSemaphore(VkDevice _device,
+                   const VkSemaphoreSignalInfo *pSignalInfo)
+{
+   VK_FROM_HANDLE(tu_device, dev, _device);
+   VK_FROM_HANDLE(vk_semaphore, sem, pSignalInfo->semaphore);
+   if (sem)
+      tu_invalidate_tl_hint(dev, vk_semaphore_get_active_sync(sem), true,
+                            pSignalInfo->value);
+   return vk_common_SignalSemaphore(_device, pSignalInfo);
+}
