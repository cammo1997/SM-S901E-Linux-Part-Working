+static int
+tu_msm_peek_fence(struct tu_device *dev, uint32_t queue_id, uint32_t fence)
+{
+   if (tu_is_msm_fence_completed(dev, queue_id, fence))
+      return 0;
+
+   struct drm_msm_wait_fence req = {
+      .fence = fence,
+      .queueid = queue_id,
+   };
+   int ret = drmCommandWrite(dev->fd, DRM_MSM_WAIT_FENCE, &req, sizeof(req));
+   if (ret == 0) {
+      tu_mark_msm_fence_completed(dev, queue_id, fence);
+      return 0;
+   }
+   if (ret == -ETIMEDOUT || (ret < 0 && errno == ETIMEDOUT))
+      return -ETIMEDOUT;
+   return -EINVAL;
+}
