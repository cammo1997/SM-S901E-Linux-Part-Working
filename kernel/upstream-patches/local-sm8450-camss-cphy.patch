+static void csiphy_sm8450_config_cphy_rate(struct csiphy_device *csiphy,
+					     s64 link_freq)
+{
+	const struct csiphy_cphy_rate_cfg *rate =
+		&sm8450_cphy_rates[ARRAY_SIZE(sm8450_cphy_rates) - 1];
+	u64 bw_bps = div_u64((u64)link_freq * 2 * 228, 100);
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(sm8450_cphy_rates); i++) {
+		if (bw_bps <= sm8450_cphy_rates[i].max_bw_bps) {
+			rate = &sm8450_cphy_rates[i];
+			break;
+		}
+	}
+
+	for (i = 0; i < 3; i++) {
+		u32 base = 0x0200 + 0x0400 * i;
+
+		writel_relaxed(0x07, csiphy->base + base + 0x74);
+		writel_relaxed(rate->r78, csiphy->base + base + 0x78);
+		writel_relaxed(0x00, csiphy->base + base + 0x88);
+		writel_relaxed(0x01, csiphy->base + base + 0x8C);
+		writel_relaxed(0x10, csiphy->base + base + 0x6C);
+		writel_relaxed(rate->r90, csiphy->base + base + 0x90);
+		writel_relaxed(rate->r14, csiphy->base + base + 0x14);
+	}
+
+	writel_relaxed(0x03, csiphy->base + 0x108C);
+}
