+	if (pd & MAX77705_PD_VDM_DP_STATUS)
+		max77705_usbc_handle_dp_status(u, MAX77705_VDM_ID_DP_STATUS);
+	if (pd & MAX77705_PD_VDM_DP_CONFIGURE)
