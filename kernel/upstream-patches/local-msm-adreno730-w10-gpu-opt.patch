+/* Pin GPU completion IRQ to the fastest online CPU (e.g. prime core) so retire
+ * and fence wakeups avoid sleeping LITTLE cores and SCHED_OTHER throttling.
+ */
+void msm_gpu_pin_irq(struct msm_gpu *gpu)
+{
+	int cpu, best_cpu = -1;
+	unsigned int best_freq = 0;
+
+	if (!gpu || gpu->irq <= 0)
+		return;
+
+	cpus_read_lock();
+	for_each_online_cpu(cpu) {
+		unsigned int max_freq = cpufreq_quick_get_max(cpu);
+
+		if (best_cpu < 0 || max_freq >= best_freq) {
+			best_freq = max_freq;
+			best_cpu = cpu;
+		}
+	}
+	if (best_cpu >= 0)
+		irq_set_affinity(gpu->irq, cpumask_of(best_cpu));
+	cpus_read_unlock();
+}
