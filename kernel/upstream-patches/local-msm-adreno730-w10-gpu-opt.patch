diff --git a/drivers/gpu/drm/msm/msm_fence.c b/drivers/gpu/drm/msm/msm_fence.c
index 10de09a..8b9bc40 100644
--- a/drivers/gpu/drm/msm/msm_fence.c
+++ b/drivers/gpu/drm/msm/msm_fence.c
@@ -5,11 +5,20 @@
  */
 
 #include <linux/dma-fence.h>
+#include <linux/moduleparam.h>
+#include <linux/processor.h>
+#include <linux/sched/signal.h>
+
+#include <drm/gpu_scheduler.h>
 
 #include "msm_drv.h"
 #include "msm_fence.h"
 #include "msm_gpu.h"
 
+uint msm_fence_spin_us = 120;
+MODULE_PARM_DESC(fence_spin_us, "Microsecond lockless spin-poll window before sleeping on msm fences");
+module_param_named(fence_spin_us, msm_fence_spin_us, uint, 0644);
+
 static struct msm_gpu *fctx2gpu(struct msm_fence_context *fctx)
 {
 	struct msm_drm_private *priv = fctx->dev->dev_private;
@@ -164,10 +173,106 @@ static void msm_fence_set_deadline(struct dma_fence *fence, ktime_t deadline)
 	spin_unlock_irqrestore(&fctx->spinlock, flags);
 }
 
+static const struct dma_fence_ops msm_fence_ops;
+
+static struct dma_fence *msm_fence_unwrap_hw(struct dma_fence *fence)
+{
+	struct drm_sched_fence *s_fence = to_drm_sched_fence(fence);
+
+	if (s_fence)
+		return smp_load_acquire(&s_fence->parent);
+
+	return fence;
+}
+
+/**
+ * msm_fence_peek_completed - Locklessly peek if an msm fence has retired on GPU
+ * @fence: dma_fence (or drm_sched_fence wrapping an msm hw fence) to inspect
+ *
+ * Unwraps drm_sched_fence->parent when needed and reads the GPU's
+ * memory-written fence counter before falling back to sleeping waits.
+ */
+bool msm_fence_peek_completed(struct dma_fence *fence)
+{
+	struct dma_fence *hw;
+	struct msm_fence *f;
+	uint32_t seqno;
+
+	if (test_bit(DMA_FENCE_FLAG_SIGNALED_BIT, &fence->flags))
+		return true;
+
+	hw = msm_fence_unwrap_hw(fence);
+	if (!hw)
+		return false;
+
+	if (test_bit(DMA_FENCE_FLAG_SIGNALED_BIT, &hw->flags))
+		return true;
+
+	if (rcu_access_pointer(hw->ops) != &msm_fence_ops)
+		return false;
+
+	f = to_msm_fence(hw);
+	seqno = (uint32_t)hw->seqno;
+
+	return (int32_t)(READ_ONCE(f->fctx->completed_fence) - seqno) >= 0 ||
+	       (int32_t)(READ_ONCE(*f->fctx->fenceptr) - seqno) >= 0;
+}
+
+bool msm_fence_try_complete(struct dma_fence *fence)
+{
+	struct dma_fence *hw;
+	struct msm_fence *f;
+	uint32_t hw_seq;
+
+	if (dma_fence_is_signaled(fence))
+		return true;
+
+	hw = msm_fence_unwrap_hw(fence);
+	if (!hw)
+		return false;
+
+	if (rcu_access_pointer(hw->ops) == &msm_fence_ops) {
+		f = to_msm_fence(hw);
+		hw_seq = READ_ONCE(*f->fctx->fenceptr);
+		smp_rmb();
+
+		if ((int32_t)(hw_seq - (uint32_t)hw->seqno) >= 0) {
+			msm_update_fence(f->fctx, hw_seq);
+			dma_fence_is_signaled(hw);
+		}
+	}
+
+	return dma_fence_is_signaled(fence);
+}
+
+static signed long msm_fence_wait(struct dma_fence *fence, bool intr,
+				  signed long timeout)
+{
+	unsigned int spin_us = READ_ONCE(msm_fence_spin_us);
+
+	if (timeout > 0 && spin_us > 0 && !msm_fence_peek_completed(fence)) {
+		ktime_t spin_until = ktime_add_us(ktime_get(), spin_us);
+
+		do {
+			if (ktime_after(ktime_get(), spin_until) ||
+			    (intr && signal_pending(current)) ||
+			    need_resched())
+				break;
+			cpu_relax();
+		} while (!msm_fence_peek_completed(fence));
+	}
+
+	if (msm_fence_try_complete(fence))
+		return timeout ? timeout : 1;
+
+	return dma_fence_default_wait(fence, intr, timeout);
+}
+
 static const struct dma_fence_ops msm_fence_ops = {
 	.get_driver_name = msm_fence_get_driver_name,
 	.get_timeline_name = msm_fence_get_timeline_name,
 	.signaled = msm_fence_signaled,
+	.wait = msm_fence_wait,
 	.set_deadline = msm_fence_set_deadline,
 };
 
