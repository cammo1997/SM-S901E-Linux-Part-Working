+/*
+ * The Samsung bootloader fills in RAM only in its own DTB (from vendor_boot), not in the
+ * DTB embedded in uniLoader, so describe it here. Ranges from the ABL "RAM Partitions" log
+ * and the stock device tree memory node.
+ */
+&{/memory@a0000000} {
+	reg = <0x0 0x80000000 0x0 0x6a000000>,
+	      <0x0 0xf1c00000 0x0 0x0e400000>,
+	      <0x8 0x00000000 0x0 0x3ab00000>,
+	      <0x8 0x3b100000 0x0 0x01e00000>,
+	      <0x8 0x40000000 0x1 0x40000000>;
+};
+
+&cdsp_mem {
+	reg = <0x0 0x89900000 0x0 0x200000>;
+};
