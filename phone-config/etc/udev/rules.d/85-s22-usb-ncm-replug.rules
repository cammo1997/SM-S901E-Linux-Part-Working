# Re-arm usb0 172.16.42.1 + unudhcpd whenever Type-C / UDC reconnects or usb0 changes
SUBSYSTEM=="net", KERNEL=="usb0", ACTION=="add|change", RUN+="/usr/local/lib/s22/s22-usb-ncm-ensure.sh usb0"
SUBSYSTEM=="typec", KERNEL=="port0", ACTION=="change", RUN+="/usr/local/lib/s22/s22-usb-ncm-ensure.sh usb0"
