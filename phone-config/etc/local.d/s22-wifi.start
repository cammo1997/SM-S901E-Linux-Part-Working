#!/bin/sh
# S22: load Wi-Fi late - ath11k cold boot calibration times out at early boot but works ~20 s later.
# Enable the QCA6490 2.4 GHz internal PA rail (s3e via AOSS QMP) before calibration runs.
(
	modprobe s22-wlan-pdc 2>/dev/null || true
	sleep 20
	modprobe ath11k_pci
	sleep 25
	[ -e /sys/class/net/wlan0 ] && iw reg set AU
	echo "$(date) wlan0: $([ -e /sys/class/net/wlan0 ] && echo up || echo missing)" >> /var/log/s22-wifi.log
) &
