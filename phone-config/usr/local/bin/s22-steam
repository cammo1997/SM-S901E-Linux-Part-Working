#!/bin/sh
# SPDX-License-Identifier: MIT
# Launch Steam inside the Ubuntu 24.04 ARM64 distrobox via FEX-Emu (ARMv8.4) + Turnip Adreno 730
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
if [ -z "${WAYLAND_DISPLAY:-}" ]; then
  W=$(ls "$XDG_RUNTIME_DIR"/wayland-* 2>/dev/null | grep -v "\.lock$" | head -n 1)
  [ -n "$W" ] && export WAYLAND_DISPLAY="$(basename "$W")"
fi
if [ -z "${DISPLAY:-}" ] && [ -S /tmp/.X11-unix/X0 ]; then
  export DISPLAY=":0"
fi
if [ -z "${XAUTHORITY:-}" ]; then
  XA=$(ls -t "$XDG_RUNTIME_DIR"/xauth_* 2>/dev/null | head -n 1)
  [ -n "$XA" ] && export XAUTHORITY="$XA"
fi
# Bind-mount ONLY the FEXServer socket (not all of XDG_RUNTIME_DIR, which breaks
# pressure-vessel's wayland symlink) and disable Chromium CEF zygote sandbox.
export PRESSURE_VESSEL_FILESYSTEMS_RW="$XDG_RUNTIME_DIR/$(id -u).FEXServer.Socket"
exec distrobox enter steam-box -- FEXBash -c "steam -no-cef-sandbox $*"
